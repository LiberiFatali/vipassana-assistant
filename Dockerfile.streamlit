FROM python:3.12-slim

RUN pip install --no-cache-dir uv==0.8.13

WORKDIR /code

COPY ./pyproject.toml ./README.md ./uv.lock* ./

# Copy chatbot_agent and potential dependencies
COPY ./chatbot_agent ./chatbot_agent

# Sync all dependencies, including Streamlit
RUN uv sync --frozen

ARG COMMIT_SHA=""
ENV COMMIT_SHA=${COMMIT_SHA}

ARG AGENT_VERSION=0.0.0
ENV AGENT_VERSION=${AGENT_VERSION}

# Expose port 8080 (Cloud Run expectation)
EXPOSE 8080

ENV PORT=8080

# Command to run Streamlit app
CMD ["uv", "run", "streamlit", "run", "chatbot_agent/streamlit_app.py", "--server.port", "8080", "--server.address", "0.0.0.0"]
